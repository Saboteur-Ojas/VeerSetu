# ==============================
# veerSetu - Environment Variables
# ==============================

# Node environment
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/veersetu

# JWT secrets (use strong, random values in production)
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Internal ML (FastAPI) service
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_API_KEY=change-me-internal-api-key
ML_TIMEOUT_MS=8000

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate limiting (optional overrides)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100